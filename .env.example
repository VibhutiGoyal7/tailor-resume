# Tailor — environment reference (build brief Section 8b).
# Copy to `.env` and fill in real values. NEVER commit a real .env.
# Both the `web` and `worker` deployables need the full set.

# --- Database & queue ---
DATABASE_URL=postgresql://tailor:tailor@localhost:5432/tailor?schema=public   # Postgres, pgvector extension enabled
REDIS_URL=redis://localhost:6379                                              # BullMQ connection

# --- Auth ---
JWT_SECRET=                            # HS256 signing secret for access tokens
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=                 # Firebase Admin SDK service account, for verifying Google ID tokens
FIREBASE_PRIVATE_KEY=

# --- LLM & embeddings ---
ANTHROPIC_API_KEY=                      # if unset, JD parsing uses a canned stub (dev)
VOYAGE_API_KEY=                         # if unset, embeddings use a deterministic stub (dev)
VOYAGE_MODEL=                           # optional; defaults to voyage-3.5 (must output 1024 dims)

# --- Email ---
RESEND_API_KEY=                        # if unset, verification/reset links are logged, not sent (dev)
EMAIL_FROM=Tailor <noreply@tailor.app> # From: address for transactional email
PUBLIC_APP_URL=http://localhost:3000   # base URL used to build verification / password-reset links

# --- File storage (Cloudflare R2) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# --- App ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug                        # pino level: trace|debug|info|warn|error (default: debug in dev)

# --- Testing (not app runtime) ---
# Set RUN_DB_TESTS=1 to opt into database-backed integration tests locally.
# Left unset, `npm test` runs only unit/DB-free tests and never touches a DB.
# RUN_DB_TESTS=1
